#include <iostream>
using namespace std;

void update_elements(int data[], int count);

int main() 
{
    int total_items = 5;
    int values[total_items] = {5, 12, 8, 20, 3};

    update_elements(values, total_items);

    return 0;
}

void update_elements(int data[], int count) 
{
    for (int i = 0; i < count; i++) 
    {
        if (data[i] < 10) 
        {
            data[i] = 10;
        }
        cout << data[i] << " ";
    }
}
